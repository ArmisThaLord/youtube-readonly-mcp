# Generate a long random token yourself. Never commit the real .env file.
MCP_BEARER_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_TOKEN_FILE=token.json
# Bind only to loopback. Put a properly configured HTTPS reverse proxy in front.
HOST=127.0.0.1
PORT=8000
# Add the public host (and port if present in Host header) when using a reverse proxy.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# Browser-origin clients only: comma-separated explicitly trusted origins.
MCP_ALLOWED_ORIGINS=
